import numpy as np
import torch
import torch.nn as nn
import torch.optim as optim
from qiskit import QuantumCircuit
from qiskit.circuit import ParameterVector
from qiskit.primitives import StatevectorSampler

# --- Configuration ---
num_qubits = 2
real_data_probs = [0.1, 0.3, 0.4, 0.2] # Target distribution
batch_size = 50
num_epochs = 200
lr_d = 0.01
spsa_c = 0.1
spsa_a = 0.1

# --- Real Data Helper ---
def get_real_samples(batch_size):
    indices = np.random.choice(range(2**num_qubits), size=batch_size, p=real_data_probs)
    samples = []
    for idx in indices:
        bin_str = format(idx, f'0{num_qubits}b')
        # Little-endian mapping to match Qiskit
        samples.append([int(bit) for bit in reversed(bin_str)]) 
    return torch.tensor(samples, dtype=torch.float32)

# --- Quantum Generator ---
def build_generator_circuit(num_qubits, num_layers):
    qc = QuantumCircuit(num_qubits)
    num_params = num_qubits * num_layers
    params = ParameterVector('theta', num_params)
    
    param_idx = 0
    for _ in range(num_layers):
        for q in range(num_qubits):
            qc.ry(params[param_idx], q)
            param_idx += 1
        if num_qubits > 1:
            for q in range(num_qubits - 1):
                qc.cz(q, q+1)
                
    qc.measure_all()
    return qc, params

g_layers = 2
g_circuit, g_param_vec = build_generator_circuit(num_qubits, g_layers)
num_g_params = len(g_param_vec)
g_params = np.random.uniform(-np.pi, np.pi, num_g_params)
sampler = StatevectorSampler()

# --- THE FIX IS HERE ---
def get_fake_samples(params, batch_size):
    # 1. Tile the 1D parameters into a (batch_size, num_params) 2D array
    # This tells the sampler to run 'batch_size' independent experiments
    parameter_values = np.tile(params, (batch_size, 1))
    
    # 2. Create the Pub (Primitive Unified Bloc) using the array
    pub = (g_circuit, parameter_values)
    
    # 3. Run with shots=1 for each parameter set in the batch
    job = sampler.run([pub], shots=1)
    result = job.result()[0]
    
    # 4. Efficiently extract bitstrings from the BitArray
    # result.data.meas is the default register name for measure_all()
    bitstrings = result.data.meas.get_bitstrings()
    
    samples = []
    for bs in bitstrings:
        # Convert '01' string to [1, 0] tensor (matching Qiskit's little-endian)
        samples.append([int(bit) for bit in reversed(bs)])
        
    return torch.tensor(samples, dtype=torch.float32)

# --- Classical Discriminator ---
class Discriminator(nn.Module):
    def __init__(self, input_dim):
        super().__init__()
        self.model = nn.Sequential(
            nn.Linear(input_dim, 8),
            nn.LeakyReLU(0.2),
            nn.Linear(8, 1),
            nn.Sigmoid()
        )
        
    def forward(self, x):
        return self.model(x)

discriminator = Discriminator(num_qubits)
d_optimizer = optim.Adam(discriminator.parameters(), lr=lr_d)
criterion = nn.BCELoss()

# --- Training Loop ---
print("Starting Training...")
for epoch in range(num_epochs):
    # 1. Train Discriminator
    discriminator.zero_grad()
    
    real_samples = get_real_samples(batch_size)
    d_out_real = discriminator(real_samples)
    d_loss_real = criterion(d_out_real, torch.ones_like(d_out_real))
    
    fake_samples_d = get_fake_samples(g_params, batch_size)
    d_out_fake = discriminator(fake_samples_d.detach())
    d_loss_fake = criterion(d_out_fake, torch.zeros_like(d_out_fake))
    
    d_loss = (d_loss_real + d_loss_fake) / 2
    d_loss.backward()
    d_optimizer.step()

    # 2. Train Generator (SPSA)
    delta = 2 * np.random.randint(0, 2, size=num_g_params) - 1
    params_plus = g_params + spsa_c * delta
    params_minus = g_params - spsa_c * delta
    
    fake_out_plus = discriminator(get_fake_samples(params_plus, batch_size)).mean().item()
    fake_out_minus = discriminator(get_fake_samples(params_minus, batch_size)).mean().item()
    
    # Loss is -log(D(G(z)))
    loss_plus = -np.log(fake_out_plus + 1e-8)
    loss_minus = -np.log(fake_out_minus + 1e-8)
    
    g_gradient = (loss_plus - loss_minus) / (2 * spsa_c) * delta
    g_params = g_params - spsa_a * g_gradient

    if epoch % 20 == 0:
        with torch.no_grad():
            test_samples = get_fake_samples(g_params, 100)
            d_score = discriminator(test_samples).mean().item()
            print(f"Epoch {epoch}: D Loss: {d_loss.item():.4f}, G Score: {d_score:.4f}")

# --- Results ---
print("\nTraining Complete.")
final_samples = get_fake_samples(g_params, 1000)
counts = {}

# Convert tensors back to bitstrings for display
for s in final_samples.tolist():
    # Reverse logic to get back '00', '01' strings
    s_ints = [int(x) for x in s]
    s_str = "".join(str(b) for b in reversed(s_ints))
    counts[s_str] = counts.get(s_str, 0) + 1

total = sum(counts.values())
print("\nTarget Probabilities: ", dict(zip(['00','10','01','11'], real_data_probs)))
print("Generated Probabilities:", {k: f"{v/total:.3f}" for k, v in counts.items()})
