import numpy as np
import matplotlib.pyplot as plt
import stim
from qiskit import QuantumCircuit, transpile
from qiskit_aer import AerSimulator
from qiskit_ibm_runtime.fake_provider import FakeManilaV2
import warnings

warnings.filterwarnings("ignore")

shots = 5000
d = 3  
backend = FakeManilaV2() 

props = backend.properties()
readout_errs = [props.readout_error(q) for q in range(5)]
avg_readout_err = np.mean(readout_errs)
cx_errs = [props.gate_error('cx', [0, 1]), props.gate_error('cx', [1, 2])]
avg_gate_err = np.mean(cx_errs)

print(f"--- Benchmarking Distance-{d} Repetition Code ---")
print(f"Device: {backend.name}")
print(f"Avg Readout Error: {avg_readout_err:.4f}")
print(f"Avg CX Gate Error: {avg_gate_err:.4f}\n")

qc = QuantumCircuit(5, 2)
qc.barrier()
qc.cx(0, 1)
qc.cx(2, 1) 
qc.cx(2, 3)
qc.cx(4, 3) 
qc.barrier()
qc.measure([1, 3], [0, 1]) 

real_sim = AerSimulator.from_backend(backend)
t_qc = transpile(qc, real_sim)
counts = real_sim.run(t_qc, shots=shots).result().get_counts()

hw_success_rate = counts.get('00', 0) / shots
print(f"Hardware Success Rate: {hw_success_rate:.2%}")

stim_circuit = stim.Circuit.generated(
    "repetition_code:memory",
    distance=d,
    rounds=1,
    after_clifford_depolarization=avg_gate_err,
    before_measure_flip_probability=avg_readout_err # FIXED ARGUMENT NAME
)

sampler = stim_circuit.compile_detector_sampler()
defects = sampler.sample(shots=shots)
stim_success_rate = np.sum(~np.any(defects, axis=1)) / shots
print(f"Stim Predicted Rate: {stim_success_rate:.2%}")

labels = ['IBM Hardware (Noisy Sim)', 'Stim Prediction']
values = [hw_success_rate, stim_success_rate]

plt.figure(figsize=(8, 6))
bars = plt.bar(labels, values, color=['#6c5ce7', '#00b894'])
plt.ylim(0, 1.1)
plt.ylabel("Probability of Zero Syndromes")
plt.title(f"Hardware vs. Stim Prediction (d={d} Repetition Code)")

for bar in bars:
    yval = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2, yval + 0.02, f"{yval:.2%}", ha='center', fontweight='bold')

plt.grid(axis='y', alpha=0.3)
plt.show()
